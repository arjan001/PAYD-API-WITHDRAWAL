# ─────────────────────────────────────────────────────────────────────────────
# Payd Dashboard — Local Development Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Netlify deployment, add these variables in:
#   Netlify → Site → Configuration → Environment Variables
#
# The .env file is loaded automatically in local dev and is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local install:  postgresql://postgres:yourpassword@localhost:5432/payd
# Supabase:       postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
# Neon:           postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# IMPORTANT for Netlify/production: always append ?sslmode=require for hosted databases.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/payd

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign JWT session cookies. Use a long random string (64+ chars).
# Generate one:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars

# ── Payd Gateway ─────────────────────────────────────────────────────────────
# API key credentials from Payd → Profile → API Keys (NOT your account login).
# These are fallback/admin values. Per-user credentials are set via the Settings page.
PAYD_USERNAME=your_payd_api_key_username
PAYD_PASSWORD=your_payd_api_key_password
PAYD_ACCOUNT_USERNAME=your_payd_profile_username

# ── Payhero Gateway ──────────────────────────────────────────────────────────
# From your Payhero dashboard.
PAYHERO_AUTH_TOKEN=Basic your_base64_auth_token_here
PAYHERO_CHANNEL_ID=your_channel_id

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Public base URL where Payd/Payhero POST payment status callbacks.
# Local dev: use ngrok → https://abc123.ngrok.io
# Netlify:   https://your-site.netlify.app
APP_PUBLIC_URL=http://localhost:8080
