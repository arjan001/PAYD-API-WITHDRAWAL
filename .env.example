# ─────────────────────────────────────────────────────────────────────────────
# Payd Dashboard — Local Development Environment Variables
#
# Copy this file to .env in the project root and fill in your values.
# The .env file is read automatically when you run the API server locally.
# It is NOT committed to git — keep it private.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your local values, then:
#   pnpm --filter @workspace/api-server run dev
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Connection string for your local (or remote) PostgreSQL instance.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Examples:
#   Local install:   postgresql://postgres:yourpassword@localhost:5432/payd
#   Supabase:        postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
#   Neon:            postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/payd

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign JWT session cookies. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_secret

# ── Payd Gateway ─────────────────────────────────────────────────────────────
# Your Payd account credentials. These are per-user in production but can be
# set here as a fallback for local testing with the admin panel.
PAYD_USERNAME=your_payd_username
PAYD_PASSWORD=your_payd_password
PAYD_ACCOUNT_USERNAME=your_payd_account_username

# ── Payhero Gateway ──────────────────────────────────────────────────────────
# Base64-encoded Basic auth token from your Payhero dashboard.
PAYHERO_AUTH_TOKEN=Basic your_base64_auth_token_here
PAYHERO_CHANNEL_ID=your_channel_id

# ── Webhook / Callback URLs ───────────────────────────────────────────────────
# Public URL where Payd/Payhero can POST payment status callbacks.
# For local dev, use a tunnel tool like ngrok:
#   ngrok http 8080
# then set this to your ngrok URL (e.g. https://abc123.ngrok.io)
APP_PUBLIC_URL=http://localhost:8080
